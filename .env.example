# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Neon Auth
NEON_AUTH_BASE_URL="https://your-project.auth.neon.tech"
# Secret for signing session cookies — MUST be at least 32 characters.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="change-me-min-32-chars-openssl-rand-base64-32"

# Access control — comma-separated list of authorised emails.
# REQUIRED: leave empty and new sign-ups are DENIED (fail-closed).
# Pre-fill with the family emails before deploying.
# WARNING: every email on this list joins the ONE existing household (getHousehold()
# uses prisma.household.findFirst()), so each address sees the same envelopes and money.
# Only list people who share this budget; another household needs its own deployment
# and database. An address whose email is not verified is refused regardless.
ALLOWED_EMAILS="alice@example.com,bob@example.com"

# Docker Compose only (compose.yaml): password of the bundled Postgres, which compose
# also splices into DATABASE_URL/DIRECT_URL (it overrides the two above). Letters and
# digits only, or the URL breaks. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=""

# Public demo only. DEMO_MODE=1 turns sign-in OFF and serves one fictional household
# to anyone with the URL. Never set it on a real deployment: the app refuses to serve
# if ALLOWED_EMAILS is non-empty, or if the database holds any household or any user
# other than the demo ones.
# In demo mode the two Neon Auth variables above are not needed.
DEMO_MODE=""
