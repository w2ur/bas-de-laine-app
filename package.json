{
  "name": "bas-de-laine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npx prisma migrate deploy; else echo \"Skipping prisma migrate deploy on VERCEL_ENV=$VERCEL_ENV (preview shares the production database; migrations apply on production deploys only)\"; fi && next build --webpack",
    "start": "next start",
    "lint": "npm run typecheck:seed && eslint",
    "typecheck:seed": "tsc --noEmit -p tsconfig.seed.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "db:studio": "npx prisma studio",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.5.0-beta",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@serwist/next": "^9.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "fast-check": "^4.6.0",
    "prisma": "^7.8.0",
    "serwist": "^9.5.6",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "zod@^4.0.0": "^4.6.7"
  }
}
